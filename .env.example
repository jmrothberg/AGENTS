# =============================================================================
# Obedient Beast - Environment Configuration
# =============================================================================
# Canonical location: copy to the REPO ROOT (next to lfm_thinking.py):
#   cp .env.example .env
#
# Python loads repo-root .env, then obedient_beast/.env, then cwd.
# .env is gitignored — never commit it.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Backend — "lfm" means any local model (legacy name), or openai / claude
# -----------------------------------------------------------------------------
LLM_BACKEND=lfm

# Fallback chain if the primary backend fails (optional)
# LLM_FALLBACK=claude,openai

# -----------------------------------------------------------------------------
# API Keys (only needed for the backend you're using)
# -----------------------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
# OPENAI_API_KEY=sk-your-key-here

# -----------------------------------------------------------------------------
# Local model server (LLM_BACKEND=lfm)
# -----------------------------------------------------------------------------
# No /v1 suffix — the client appends /v1/chat/completions
LFM_URL=http://localhost:8000
LFM_URL_REMOTE=http://YOUR_SERVER_IP:8000
LFM_MODEL=Qwen3.8-27B-mxfp8
# LFM_MAX_TOKENS=16384

# Qwen3.8 thinking knobs (ignored by Claude/OpenAI)
QWEN_REASONING_EFFORT=medium
QWEN_ENABLE_THINKING=true
QWEN_PRESERVE_THINKING=true

# Tool groups offered to a local 27B (cloud defaults to all).
# Groups: core, browser, art, desktop, mcp_mgmt, spawn — or "all"
# BEAST_TOOL_GROUPS=core,browser,art

# -----------------------------------------------------------------------------
# WhatsApp Access Control
# -----------------------------------------------------------------------------
ALLOWED_NUMBERS=+12025551234
ALLOWED_GROUPS=
RESPOND_TO_OTHERS=false

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
BEAST_PORT=5001

# -----------------------------------------------------------------------------
# MCP
# -----------------------------------------------------------------------------
MCP_ENABLED=false
# BRAVE_API_KEY=BSA_your-api-key-here

# -----------------------------------------------------------------------------
# Task Notifications
# -----------------------------------------------------------------------------
NOTIFICATION_CHAT_ID=
